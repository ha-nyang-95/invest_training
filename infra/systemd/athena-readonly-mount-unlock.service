[Unit]
# Athena F5 readonly-mount UNLOCK — Story 1.6 AC-2.
# Runs at 15:30 KST (KRX close + 30s buffer) every weekday so the operator
# can edit policy / commit changes / run 72h cooling gate (Story 1.3) until
# the next 09:00 lock.
Description=Athena F5 — Unlock policy directory (chattr -i) at KRX close
After=local-fs.target
ConditionPathExists=/var/lib/athena/policy/policy.toml
ConditionPathExists=/var/lib/athena/policy/flag_registry.toml

[Service]
Type=oneshot
User=khuk0
Group=khuk0
ExecStartPre=/home/khuk0/invest_training/.venv/bin/python /home/khuk0/invest_training/scripts/check_trading_day.py
ExecStart=/home/khuk0/invest_training/.venv/bin/python -m athena.alpha_defense.f5 unlock
ExecStopPost=/home/khuk0/invest_training/.venv/bin/python /home/khuk0/invest_training/scripts/emit_readonly_mount_metric.py --action unlock --exit-code $EXIT_STATUS --output /var/lib/node_exporter/textfile_collector/athena_readonly_mount.prom
StandardOutput=append:/var/log/athena/readonly-mount.log
StandardError=append:/var/log/athena/readonly-mount.log
Restart=on-failure
RestartSec=30s
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
